generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VideoJob {
  id       String  @id
  status   String // "PENDING", "PROCESSING", "READY", "FAILED"
  videoUrl String?
  error    String?
}
