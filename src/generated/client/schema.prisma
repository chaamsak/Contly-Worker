generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VideoJob {
  id       String      @id
  status   VideoStatus @default(PENDING)
  videoUrl String?
  error    String?
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}
